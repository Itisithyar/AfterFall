# UE5 gitignore (generated for AFTERFALL, UE 5.8, Windows client+server)
# Compiled binaries
Binaries/
DerivedDataCache/
Intermediate/
Saved/
# Build artifacts
Build/
Builds/
*.sln
*.slnx
*.suo
*.user
# VS artifacts
.vs/
*.VC.db
*.opensdf
*.sdf
*.suo
*.xcodeproj
*.xcworkspace
# Rider
.idea/
# OS
.DS_Store
Thumbs.db
# Packaging
*.pdb
*.ipdb
# Quarantined broken assets (restored after in-editor fix, never cooked/shipped).
Content/**/*.bak
Content/**/*.bak/*
# Duplicate Epic-template project (source only, 134M). Canonical project is root Afterfall.uproject.
# Template art merged to root Content/FirstPerson, Input, LevelPrototyping + Config/DefaultInput.ini.
/AfterFall/
# Keep project files
!*.uproject
!*.uplugin
!Source/**/*.cpp
!Source/**/*.h
!Source/**/*.cs
!Config/**/*.ini
!Content/**/*.uasset
!*.sh

# The old fork lives in Real Game by owner decision, and the main project is
# layered into it. Only the fork's generated output stays ignored; the project
# files themselves (uproject, Config, Content) are visible for layering/import.
Real Game/Binaries/
Real Game/Intermediate/
Real Game/DerivedDataCache/
Real Game/Saved/
Real Game/Binaries_fork/
Real Game/Intermediate_fork/
Real Game/.vs/
Real Game/*.sln

# Stray template-project copies and scratch build logs at the repo root.
/AfterFall 5.8/
/Afterfall 5.8/
_*.txt
_*.log

# Generated/local-only working dirs — never committed (packages, caches,
# backups, and the sibling animation tool project with its own .uproject).
/AfterFallAnimation/
/AfterfallStaging/
/AfterfallStaging_*/
/AfterfallSafetyBackups/
/VaultCache/
/.build_monitor/
Scripts/__pycache__/

# Consolidation recovery bundle (local backup artifact, not source).
/Recovery-*.bundle
